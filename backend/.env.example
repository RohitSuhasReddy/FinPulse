# The backend loads backend/.env automatically. Never commit real keys.
# Copy this file to backend/.env and fill values as needed.
FINPULSE_DISABLE_CACHE=0
# FINPULSE_DB_PATH=./.local/finpulse.sqlite3
FINPULSE_SENTIMENT=rules

# OPTIONAL: Gemini is used only for commentary on historical stock movement.
# Without a key, the report and market chart still work normally.
GEMINI_API_KEY=
FINPULSE_GEMINI_MODEL=gemini-3.5-flash

# To use optional offline FinBERT, install requirements-ml.txt and pre-cache weights.
